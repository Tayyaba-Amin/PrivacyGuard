# ---------------------------------------------------------------------------
# PrivacyGuard - server configuration
#
# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored and must never be committed.
#
# Everything in this file is read by the backend only. No value here is ever
# sent to the browser. Any variable prefixed with VITE_ in apps/web IS public
# and is inlined into the client bundle, so never put a secret in one.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://privacy-guard-phi.vercel.app

# --- Input limits (untrusted request hardening) -----------------------------
# Maximum characters accepted by POST /api/analyze/text. Larger bodies get a 413.
MAX_TEXT_CHARS=20000

# --- AI contextual analysis --------------------------------------------------
# PrivacyGuard works without these values. With no FEATHERLESS_API_KEY the
# deterministic engine still returns every finding and the response reports
# `aiStatus: "unavailable"`; nothing is faked.
#
# Only the detected spans and a bounded window of surrounding text are sent. The
# key stays on the server: it is never logged and never reaches the browser.
FEATHERLESS_API_KEY=

# Model id on Featherless. Must be a model your account can run; see
# https://featherless.ai/models
FEATHERLESS_MODEL=Qwen/Qwen3-8B

# Featherless base URL. It exposes an OpenAI-compatible /chat/completions, so no
# SDK is involved. Override this only to point at a proxy or a local mock.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Hard ceiling for the whole AI stage of one analyze request. A stalled provider
# is abandoned at this point and the deterministic findings are returned instead.
FEATHERLESS_TIMEOUT_MS=15000

# Upper bound on user-text characters placed into a single prompt. Longer text is
# split into batches around each detected span; findings are never dropped.
FEATHERLESS_MAX_CONTEXT_CHARS=4000

# Upper bound on the model's reply, in tokens.
FEATHERLESS_MAX_TOKENS=1200

# Set to false to switch the contextual layer off entirely. Detection is
# unaffected; the response then reports `aiStatus: "unavailable"`.
AI_ENABLED=true